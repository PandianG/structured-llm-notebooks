# ============================================
# Structured LLM Notebooks — Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys.
# You only need the keys for the services you plan to use.

# --- OpenAI (Required for most notebooks, unless using Ollama) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Anthropic (Required for Claude notebooks) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Azure OpenAI (Optional — enterprise) ---
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================
# Cost Control Settings
# ============================================
# Set USE_OLLAMA=true to run all notebooks with free local models
USE_OLLAMA=false

# Set USE_SMALL_MODEL=true to use gpt-4o-mini (10x cheaper than gpt-4o)
USE_SMALL_MODEL=false

# Ollama base URL (change if running remotely)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Notebook Settings
# ============================================
# Reduce sample sizes for faster/cheaper runs
SAMPLE_SIZE=50

# DSPy optimizer trials (reduce to save API costs)
DSPY_OPTIMIZER_TRIALS=10

# Max retries for Instructor validation
INSTRUCTOR_MAX_RETRIES=3

# ============================================
# Paths
# ============================================
DATA_DIR=./data
NOTEBOOK_DIR=./notebooks
